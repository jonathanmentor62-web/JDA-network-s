rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================

    function signedIn() {
      return request.auth != null;
    }

    function approved() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "approved";
    }

    function admin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }


    // =========================
    // USERS
    // =========================

    match /users/{uid} {

      // A newly registered user can create only their own
      // pending account.
      allow create:
        if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending";


      // Admins can read all users.
      // A user can read their own account.
      // Approved users can read user profiles.
      allow read:
        if admin()
        || (signedIn() && request.auth.uid == uid)
        || approved();


      // Admins can approve/reject/disable users.
      //
      // Normal users may update their own profile,
      // but they cannot change their uid or account status.
      allow update:
        if admin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status == resource.data.status
        );


      allow delete:
        if admin();
    }


    // =========================
    // USERNAMES
    // =========================

    match /usernames/{username} {

      allow read:
        if signedIn();

      allow create:
        if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete:
        if admin();
    }


    // =========================
    // ADMINS
    // =========================

    match /admins/{uid} {

      allow read:
        if admin()
        || (signedIn() && request.auth.uid == uid);

      // Only an existing admin can change admin records.
      allow write:
        if admin();
    }


    // =========================
    // CONNECTIONS / NETWORK
    // =========================

    match /connections/{connectionId} {

      allow read:
        if approved()
        && (
          resource.data.from == request.auth.uid
          || resource.data.to == request.auth.uid
        );

      allow create:
        if approved()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid;

      allow delete:
        if approved()
        && resource.data.from == request.auth.uid;
    }


    // =========================
    // CONVERSATIONS
    // =========================

    match /conversations/{conversationId} {

      // Only members of a conversation can read it.
      allow read:
        if approved()
        && request.auth.uid in resource.data.members;


      // A conversation must contain exactly two members
      // for one-to-one messaging.
      allow create:
        if approved()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;


      allow update:
        if approved()
        && request.auth.uid in resource.data.members;


      allow delete:
        if approved()
        && request.auth.uid in resource.data.members;


      // =========================
      // MESSAGES
      // =========================

      match /messages/{messageId} {

        // Only conversation members can read messages.
        allow read:
          if approved()
          && request.auth.uid in
            get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.members;


        // Users can create messages only as themselves
        // inside a conversation they belong to.
        allow create:
          if approved()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
            get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.members;


        // Only the sender can modify or delete their message.
        allow update, delete:
          if approved()
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}