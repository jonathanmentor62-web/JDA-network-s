rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================================
    // HELPERS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }


    // =====================================================
    // USERS
    // =====================================================

    match /users/{uid} {

      // Anyone signed in can create their own profile.
      allow create:
        if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.realName is string
        && request.resource.data.realName.size() >= 3;

      // Any signed-in user can read any user profile
      // (needed to show contacts and chat partners).
      allow get, list:
        if signedIn();

      // Owner can update their own profile.
      allow update:
        if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      // Owner can delete their own profile.
      allow delete:
        if signedIn()
        && request.auth.uid == uid;
    }


    // =====================================================
    // CONVERSATIONS
    // =====================================================

    match /conversations/{conversationId} {

      allow get, list:
        if signedIn()
        && request.auth.uid in resource.data.participantIds;

      allow create:
        if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;

      allow update:
        if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds
           == resource.data.participantIds;

      allow delete:
        if signedIn()
        && request.auth.uid in resource.data.participantIds;


      // ===================================================
      // MESSAGES
      // ===================================================

      match /messages/{messageId} {

        allow read:
          if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds;

        allow create:
          if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        allow update:
          if false;

        allow delete:
          if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds;
      }
    }


    // =====================================================
    // CALLS
    // =====================================================

    match /calls/{callId} {

      allow create:
        if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.type in ["audio", "video"]
        && request.resource.data.status == "ringing";

      allow get:
        if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );

      allow list:
        if signedIn();

      allow update:
        if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        )
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.type == resource.data.type
        && request.resource.data.status
           in ["ringing", "accepted", "rejected", "ended"];

      allow delete:
        if signedIn()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );


      // ===================================================
      // ICE CANDIDATES
      // ===================================================

      match /candidates/{candidateId} {

        allow create:
          if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && (
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.callerId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.calleeId == request.auth.uid
          )
          && request.resource.data.candidate is map;

        allow get, list:
          if signedIn()
          && (
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.callerId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.calleeId == request.auth.uid
          );

        allow update:
          if false;

        allow delete:
          if signedIn()
          && (
            resource.data.senderId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.callerId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.calleeId == request.auth.uid
          );
      }
    }


    // =====================================================
    // CONNECTIONS
    // =====================================================

    match /connections/{connectionId} {

      allow read:
        if signedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow create:
        if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid;

      allow delete:
        if signedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );
    }


    // =====================================================
    // NOTIFICATIONS
    // =====================================================

    match /notifications/{notificationId} {

      allow read:
        if signedIn()
        && resource.data.userId == request.auth.uid;

      // Any signed-in user can create a notification
      // for another user (used for message/call alerts).
      allow create:
        if signedIn()
        && request.resource.data.userId is string;

      allow update:
        if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.type == resource.data.type;

      allow delete:
        if signedIn()
        && resource.data.userId == request.auth.uid;
    }


    // =====================================================
    // DEVICE TOKENS
    // =====================================================

    match /deviceTokens/{tokenId} {

      allow create, update:
        if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0;

      allow delete:
        if signedIn()
        && resource.data.userId == request.auth.uid;

      allow read:
        if false;
    }

  }
}