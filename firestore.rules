rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================================
    // HELPER FUNCTIONS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function superAdmin() {
      return signedIn()
        && request.auth.token.email
           == "jonathanmentor62@gmail.com";
    }

    function admin() {
      return superAdmin()
        || (
          signedIn()
          && exists(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          )
        );
    }

    function myUser() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function approved() {
      return myUser()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "approved";
    }


    // =====================================================
    // USERS
    // =====================================================

    match /users/{uid} {

      allow create:
        if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending"
        && request.resource.data.approved == false
        && request.resource.data.realName is string
        && request.resource.data.realName.size() >= 3
        && request.resource.data.jdaNumber is string
        && request.resource.data.accountType in ["student", "staff"];

      allow get:
        if signedIn()
        && (
          request.auth.uid == uid
          || admin()
          || approved()
        );

      allow list:
        if admin() || approved();

      allow update:
        if admin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "isOnline",
              "lastSeen"
            ])
        );

      allow delete:
        if superAdmin();
    }


    // =====================================================
    // ADMINS
    // =====================================================

    match /admins/{uid} {

      allow read:
        if signedIn()
        && (
          request.auth.uid == uid
          || admin()
        );

      allow create, update, delete:
        if superAdmin();
    }


    // =====================================================
    // CONVERSATIONS
    // =====================================================

    match /conversations/{conversationId} {

      allow get:
        if approved();

      allow list:
        if approved();

      allow create:
        if approved()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;

      allow update:
        if approved()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds
           == resource.data.participantIds;

      allow delete:
        if admin();


      // ===================================================
      // MESSAGES
      // ===================================================

      match /messages/{messageId} {

        allow read:
          if approved()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds;

        allow create:
          if approved()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        allow update:
          if false;

        allow delete:
          if admin();
      }
    }


    // =====================================================
    // REAL WEBRTC CALLS
    // =====================================================

    match /calls/{callId} {

      // A JDA-approved member can create a call
      // only for another approved JDA member.
      allow create:
        if approved()
        && request.resource.data.callerId
           == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId
           != request.auth.uid
        && request.resource.data.type
           in ["audio", "video"]
        && request.resource.data.status
           == "ringing"
        && get(
          /databases/$(database)/documents/users/$(request.resource.data.calleeId)
        ).data.status == "approved";

      // Caller and receiver can see the call.
      allow get:
        if approved()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );

      // Required for the incoming-call listener.
      allow list:
        if approved();

      // Caller/receiver can update the call,
      // but cannot change who is calling whom.
      allow update:
        if approved()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        )
        && request.resource.data.callerId
           == resource.data.callerId
        && request.resource.data.calleeId
           == resource.data.calleeId
        && request.resource.data.type
           == resource.data.type
        && request.resource.data.status
           in [
             "ringing",
             "accepted",
             "rejected",
             "ended"
           ];

      // Caller/receiver may remove their call.
      allow delete:
        if approved()
        && (
          resource.data.callerId == request.auth.uid
          || resource.data.calleeId == request.auth.uid
        );


      // ===================================================
      // WEBRTC ICE CANDIDATES
      // ===================================================

      match /candidates/{candidateId} {

        // Caller or receiver may send ICE candidates.
        allow create:
          if approved()
          && request.resource.data.senderId
             == request.auth.uid
          && (
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.callerId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.calleeId == request.auth.uid
          )
          && request.resource.data.candidate is map;

        // Caller or receiver can receive ICE candidates.
        allow get:
          if approved()
          && (
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.callerId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.calleeId == request.auth.uid
          );

        allow list:
          if approved()
          && (
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.callerId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.calleeId == request.auth.uid
          );

        allow update:
          if false;

        allow delete:
          if approved()
          && (
            resource.data.senderId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.callerId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/calls/$(callId)
            ).data.calleeId == request.auth.uid
          );
      }
    }


    // =====================================================
    // CONNECTIONS
    // =====================================================

    match /connections/{connectionId} {

      allow read:
        if approved()
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow create:
        if approved()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid;

      allow delete:
        if approved()
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );
    }


    // =====================================================
    // NOTIFICATIONS
    // =====================================================

    match /notifications/{notificationId} {

      allow read:
        if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create:
        if admin();

      allow update:
        if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId
           == resource.data.userId
        && request.resource.data.type
           == resource.data.type;

      allow delete:
        if admin();
    }


    // =====================================================
    // DEVICE TOKENS
    // =====================================================

    match /deviceTokens/{tokenId} {

      allow create, update:
        if signedIn()
        && request.resource.data.userId
           == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0;

      allow delete:
        if signedIn()
        && resource.data.userId
           == request.auth.uid;

      allow read:
        if false;
    }

  }
}