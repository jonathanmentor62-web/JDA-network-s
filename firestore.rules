rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function superAdmin() {
      return signedIn()
        && request.auth.token.email == "jonathanmentor62@gmail.com";
    }

    function admin() {
      return superAdmin()
        || (
          signedIn()
          && exists(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          )
        );
    }

    function myUser() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function approved() {
      return myUser()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "approved";
    }


    /* =========================
       USERS
    ========================= */

    match /users/{uid} {

      /*
       New registration.
       A user may ONLY create their own pending account.
      */

      allow create:
        if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending"
        && request.resource.data.approved == false
        && request.resource.data.realName is string
        && request.resource.data.realName.size() >= 3
        && request.resource.data.jdaNumber is string
        && request.resource.data.accountType
           in ["student", "staff"];


      /*
       Admins can review all users.
       Approved members can see the directory.
      */

      allow read:
        if admin() || approved();


      /*
       Admin controls approval/disable/rejection.
       Normal users cannot change identity or status.
      */

      allow update:
        if admin();


      allow delete:
        if superAdmin();


      /*
       No other access.
      */
    }


    /* =========================
       ADMINS
    ========================= */

    match /admins/{uid} {

      /*
       An admin can read their own admin record.
       The super admin can manage admin records.
      */

      allow read:
        if signedIn()
        && (request.auth.uid == uid || admin());

      allow create, update, delete:
        if superAdmin();
    }


    /* =========================
       CONVERSATIONS
    ========================= */

    match /conversations/{conversationId} {

      /*
       Only approved members can access conversations.
       The conversation document must contain:
       participantIds: [uid1, uid2]
      */

      allow read:
        if approved()
        && request.auth.uid
           in resource.data.participantIds;


      allow create:
        if approved()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid
           in request.resource.data.participantIds;


      allow update:
        if approved()
        && request.auth.uid
           in resource.data.participantIds
        && request.resource.data.participantIds
           == resource.data.participantIds;


      allow delete:
        if admin();


      /* =========================
         MESSAGES
      ========================= */

      match /messages/{messageId} {

        allow read:
          if approved()
          && request.auth.uid
             in get(
               /databases/$(database)/documents/conversations/$(conversationId)
             ).data.participantIds;


        allow create:
          if approved()
          && request.auth.uid
             in get(
               /databases/$(database)/documents/conversations/$(conversationId)
             ).data.participantIds
          && request.resource.data.senderId
             == request.auth.uid
          && request.resource.data.receiverId
             in get(
               /databases/$(database)/documents/conversations/$(conversationId)
             ).data.participantIds
          && request.resource.data.receiverId
             != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;


        /*
         Messages cannot be secretly edited.
         */

        allow update:
          if false;


        /*
         Only an admin can delete messages.
         */

        allow delete:
          if admin();
      }
    }


    /* =========================
       CONNECTIONS
    ========================= */

    match /connections/{connectionId} {

      /*
       Connection documents must contain:
       requesterId
       receiverId
      */

      allow read:
        if approved()
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );


      allow create:
        if approved()
        && request.resource.data.requesterId
           == request.auth.uid
        && request.resource.data.receiverId
           != request.auth.uid;


      allow delete:
        if approved()
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );
    }


    /* =========================
       NOTIFICATIONS
    ========================= */

    match /notifications/{notificationId} {

      allow read:
        if signedIn()
        && resource.data.userId
           == request.auth.uid;


      /*
       Only the server/admin should create
       registration approval notifications.
      */

      allow create:
        if admin();


      allow update:
        if signedIn()
        && resource.data.userId
           == request.auth.uid;


      allow delete:
        if admin();
    }

  }
}