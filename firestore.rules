rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /* =====================================
       BASIC SECURITY FUNCTIONS
    ===================================== */

    function signedIn() {
      return request.auth != null;
    }


    function superAdmin() {
      return signedIn()
        && request.auth.token.email
           == "jonathanmentor62@gmail.com";
    }


    function admin() {
      return superAdmin()
        || (
          signedIn()
          && exists(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          )
        );
    }


    function myUser() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }


    function approved() {
      return myUser()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "approved";
    }



    /* =====================================
       USERS
    ===================================== */

    match /users/{uid} {

      /*
       NEW REGISTRATION

       A person can create only their own
       account and it must start as pending.
      */

      allow create:
        if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending"
        && request.resource.data.approved == false
        && request.resource.data.realName is string
        && request.resource.data.realName.size() >= 3
        && request.resource.data.jdaNumber is string
        && request.resource.data.accountType
           in ["student", "staff"];


      /*
       Administrators can review users.

       Approved members can access the
       JDA member directory.
      */

      allow read:
        if admin() || approved();


      /*
       ONLY ADMINISTRATORS can change:

       - approval
       - rejection
       - disabled status
       - identity/profile information
      */

      allow update:
        if admin();


      /*
       Only the super administrator can
       permanently delete a user document.
      */

      allow delete:
        if superAdmin();

    }



    /* =====================================
       ADMIN ACCOUNTS
    ===================================== */

    match /admins/{uid} {

      /*
       An administrator can see their own
       admin record.

       Existing administrators can also
       see admin records.
      */

      allow read:
        if signedIn()
        && (
          request.auth.uid == uid
          || admin()
        );


      /*
       Only the super administrator can
       create, change or remove administrators.
      */

      allow create, update, delete:
        if superAdmin();

    }



    /* =====================================
       PRIVATE CONVERSATIONS
    ===================================== */

    match /conversations/{conversationId} {

      /*
       A conversation must contain exactly
       two participant UIDs.

       Example:

       participantIds:
       [
         "USER_A",
         "USER_B"
       ]
      */

      allow read:
        if approved()
        && resource.data.participantIds is list
        && request.auth.uid
           in resource.data.participantIds;


      /*
       Only an approved member can create
       a conversation involving themselves.
      */

      allow create:
        if approved()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid
           in request.resource.data.participantIds;


      /*
       Participants can update conversation
       metadata, but cannot change who is
       participating.
      */

      allow update:
        if approved()
        && request.auth.uid
           in resource.data.participantIds
        && request.resource.data.participantIds
           == resource.data.participantIds;


      /*
       Admins can delete conversations.
      */

      allow delete:
        if admin();



      /* =================================
         MESSAGES
      ================================= */

      match /messages/{messageId} {

        /*
         Only conversation participants
         can read messages.
        */

        allow read:
          if approved()
          && request.auth.uid
             in get(
               /databases/$(database)/documents/conversations/$(conversationId)
             ).data.participantIds;


        /*
         A member can send only as themselves.

         The receiver must also be one of
         the two conversation participants.
        */

        allow create:
          if approved()

          && request.auth.uid
             in get(
               /databases/$(database)/documents/conversations/$(conversationId)
             ).data.participantIds

          && request.resource.data.senderId
             == request.auth.uid

          && request.resource.data.receiverId
             in get(
               /databases/$(database)/documents/conversations/$(conversationId)
             ).data.participantIds

          && request.resource.data.receiverId
             != request.auth.uid

          && request.resource.data.text is string

          && request.resource.data.text.size() > 0

          && request.resource.data.text.size() <= 5000;


        /*
         Messages cannot be edited from
         the client.
        */

        allow update:
          if false;


        /*
         Admins can remove messages.
        */

        allow delete:
          if admin();

      }

    }



    /* =====================================
       CONNECTIONS
    ===================================== */

    match /connections/{connectionId} {

      /*
       A connection document contains:

       requesterId
       receiverId
      */

      allow read:
        if approved()
        && (
          resource.data.requesterId
             == request.auth.uid

          || resource.data.receiverId
             == request.auth.uid
        );


      /*
       Users can create a connection request
       only as themselves.
      */

      allow create:
        if approved()
        && request.resource.data.requesterId
           == request.auth.uid
        && request.resource.data.receiverId
           != request.auth.uid;


      /*
       Either participant can remove the
       connection.
      */

      allow delete:
        if approved()
        && (
          resource.data.requesterId
             == request.auth.uid

          || resource.data.receiverId
             == request.auth.uid
        );

    }



    /* =====================================
       NOTIFICATIONS
    ===================================== */

    match /notifications/{notificationId} {

      /*
       A user can read only notifications
       belonging to that user.
      */

      allow read:
        if signedIn()
        && resource.data.userId
           == request.auth.uid;


      /*
       A newly registering member can create
       the temporary registration event.

       IMPORTANT:
       This does NOT itself send a phone push.
       The server notification system will
       handle the actual push later.
      */

      allow create:
        if signedIn()
        && request.resource.data.type
           == "new_registration"

        && request.resource.data.userId
           == request.auth.uid

        && request.resource.data.member