rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =========================
       BASIC FUNCTIONS
    ========================= */

    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email
        == "jonathanmentor62@gmail.com";
    }

    function isAdmin() {
      return isSuperAdmin()
        || (
          signedIn()
          && exists(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          )
        );
    }

    function isApproved() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "approved";
    }


    /* =========================
       USERS
       ========================= */

    match /users/{uid} {

      /*
       * A person may create ONLY their
       * own registration.
       *
       * They MUST start as pending.
       */
      allow create:
        if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending"
        && request.resource.data.approved == false;


      /*
       * Approved members can see member
       * profiles.
       *
       * Admins can see everything.
       */
      allow read:
        if isAdmin()
        || isApproved();


      /*
       * NORMAL MEMBERS CANNOT change
       * their identity/status.
       *
       * Admin controls approval.
       */
      allow update:
        if isAdmin()
        || (
          isApproved()
          && request.auth.uid == uid

          /*
           * Identity fields cannot be changed
           * by the member.
           */
          && request.resource.data.realName
             == resource.data.realName

          && request.resource.data.jdaNumber
             == resource.data.jdaNumber

          && request.resource.data.accountType
             == resource.data.accountType

          && request.resource.data.status
             == resource.data.status

          && request.resource.data.approved
             == resource.data.approved
        );


      /*
       * Only admins can delete users.
       */
      allow delete:
        if isAdmin();
    }


    /* =========================
       ADMINS
       ========================= */

    match /admins/{uid} {

      allow read:
        if signedIn();

      /*
       * Only the super admin can create
       * another admin record.
       */
      allow create:
        if isSuperAdmin();

      allow update, delete:
        if isSuperAdmin();
    }


    /* =========================
       CONVERSATIONS
       ========================= */

    match /conversations/{conversationId} {

      /*
       * The conversation ID is built from
       * two user UIDs sorted alphabetically.
       *
       * This check makes sure the current
       * user is actually one of them.
       */
      allow read, create, update:
        if isApproved()
        && (
          conversationId.matches(
            ".*" + request.auth.uid + ".*"
          )
        );


      allow delete:
        if isAdmin();


      /* =========================
         MESSAGES
         ========================= */

      match /messages/{messageId} {

        /*
         * Approved users can read messages
         * in their own conversation.
         */
        allow read:
          if isApproved()
          && (
            resource.data.senderId
            == request.auth.uid
            ||
            resource.data.receiverId
            == request.auth.uid
          );


        /*
         * New message:
         * sender MUST be the logged-in user.
         */
        allow create:
          if isApproved()
          && request.resource.data.senderId
             == request.auth.uid
          && request.resource.data.receiverId
             != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;


        /*
         * Messages cannot be edited by normal
         * users.
         */
        allow update:
          if false;


        /*
         * Only admins can delete messages.
         */
        allow delete:
          if isAdmin();
      }
    }


    /* =========================
       CONNECTIONS
       ========================= */

    match /connections/{connectionId} {

      allow read, create, delete:
        if isApproved();
    }


    /* =========================
       NOTIFICATIONS
       ========================= */

    match /notifications/{notificationId} {

      allow read:
        if isApproved()
        && resource.data.userId
           == request.auth.uid;

      /*
       * Notifications should be generated
       * by trusted server/admin processes.
       */
      allow create:
        if isAdmin();

      allow update:
        if isApproved()
        && resource.data.userId
           == request.auth.uid;

      allow delete:
        if isAdmin();
    }

  }
}