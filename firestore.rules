rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =====================================
       BASIC SECURITY
    ===================================== */

    function signedIn() {
      return request.auth != null;
    }

    function superAdmin() {
      return signedIn()
        && request.auth.token.email
           == "jonathanmentor62@gmail.com";
    }

    function admin() {
      return superAdmin()
        || (
          signedIn()
          && exists(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          )
        );
    }

    function myUser() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function approved() {
      return myUser()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.status == "approved";
    }


    /* =====================================
       USERS
    ===================================== */

    match /users/{uid} {

      /*
       New registration must ALWAYS begin
       as pending and unapproved.
      */

      allow create:
        if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending"
        && request.resource.data.approved == false
        && request.resource.data.realName is string
        && request.resource.data.realName.size() >= 3
        && request.resource.data.jdaNumber is string
        && request.resource.data.accountType
           in ["student", "staff"];


      /*
       Admins can review users.
       Approved members can see the
       member directory.
      */

      allow read:
        if admin() || approved();


      /*
       ONLY ADMINISTRATORS can modify
       member records.

       This prevents an approved member
       from changing their own name,
       photo, JDA number, class, stream,
       department or approval status.
      */

      allow update:
        if admin();


      /*
       Only the super administrator can
       permanently delete a user.
      */

      allow delete:
        if superAdmin();

    }


    /* =====================================
       ADMINS
    ===================================== */

    match /admins/{uid} {

      allow read:
        if signedIn()
        && (
          request.auth.uid == uid
          || admin()
        );

      /*
       Only the main administrator can
       create/update/delete administrators.
      */

      allow create, update, delete:
        if superAdmin();

    }


    /* =====================================
       PRIVATE CONVERSATIONS
    ===================================== */

    match /conversations/{conversationId} {

      allow read:
        if approved()
        && resource.data.participantIds is list
        && request.auth.uid
           in resource.data.participantIds;


      allow create:
        if approved()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid
           in request.resource.data.participantIds;


      allow update:
        if approved()
        && request.auth.uid
           in resource.data.participantIds
        && request.resource.data.participantIds
           == resource.data.participantIds;


      allow delete:
        if admin();


      /* =================================
         MESSAGES
      ================================= */

      match /messages/{messageId} {

        allow read:
          if approved()
          && request.auth.uid
             in get(
               /databases/$(database)/documents/conversations/$(conversationId)
             ).data.participantIds;


        allow create:
          if approved()

          && request.auth.uid
             in get(
               /databases/$(database)/documents/conversations/$(conversationId)
             ).data.participantIds

          && request.resource.data.senderId
             == request.auth.uid

          && request.resource.data.receiverId
             in get(
               /databases/$(database)/documents/conversations/$(conversationId)
             ).data.participantIds

          && request.resource.data.receiverId
             != request.auth.uid

          && request.resource.data.text is string

          && request.resource.data.text.size() > 0

          && request.resource.data.text.size() <= 5000;


        /*
         Messages cannot be edited from
         the client.
        */

        allow update:
          if false;


        allow delete:
          if admin();

      }

    }


    /* =====================================
       CONNECTIONS
    ===================================== */

    match /connections/{connectionId} {

      allow read:
        if approved()
        && (
          resource.data.requesterId
             == request.auth.uid

          || resource.data.receiverId
             == request.auth.uid
        );


      allow create:
        if approved()
        && request.resource.data.requesterId
           == request.auth.uid
        && request.resource.data.receiverId
           != request.auth.uid;


      allow delete:
        if approved()
        && (
          resource.data.requesterId
             == request.auth.uid

          || resource.data.receiverId
             == request.auth.uid
        );

    }


    /* =====================================
       NOTIFICATIONS
    ===================================== */

    match /notifications/{notificationId} {

      /*
       Users can read only notifications
       belonging to themselves.
      */

      allow read:
        if signedIn()
        && resource.data.userId
           == request.auth.uid;


      /*
       The SERVER / Cloud Function creates
       registration notifications.

       Normal users cannot create fake
       administrator notifications.
      */

      allow create:
        if admin();


      /*
       Users may mark their own notification
       as read, but cannot transfer it to
       another account.
      */

      allow update:
        if signedIn()
        && resource.data.userId
           == request.auth.uid
        && request.resource.data.userId
           == resource.data.userId
        && request.resource.data.type
           == resource.data.type;


      allow delete:
        if admin();

    }


    /* =====================================
       DEVICE TOKENS
    ===================================== */

    match /deviceTokens/{tokenId} {

      /*
       A signed-in user can save only a
       device token belonging to themselves.
      */

      allow create, update:
        if signedIn()
        && request.resource.data.userId
           == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0;


      /*
       Users can remove their own token.
      */

      allow delete:
        if signedIn()
        && resource.data.userId
           == request.auth.uid;


      /*
       Device tokens are private.
      */

      allow read:
        if false;

    }

  }
}