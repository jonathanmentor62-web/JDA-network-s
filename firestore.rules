rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================================
    // HELPERS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function conversationParticipants(conversationId) {
      return get(
        /databases/$(database)/documents/conversations/$(conversationId)
      ).data.participantIds;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && request.auth.uid in conversationParticipants(conversationId);
    }


    // =====================================================
    // USERS
    // =====================================================

    match /users/{uid} {

      // A user creates only their own profile.
      allow create:
        if isUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.realName is string
        && request.resource.data.realName.size() >= 2
        && request.resource.data.phoneNumber is string;

      // Signed-in users can discover profiles.
      allow get, list:
        if signedIn();

      // A user can update only their own profile.
      // UID, phone number and creation time cannot be changed.
      allow update:
        if isUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.phoneNumber == resource.data.phoneNumber
        && request.resource.data.createdAt == resource.data.createdAt;

      // Users cannot delete their Firestore profile from the app.
      allow delete:
        if false;
    }


    // =====================================================
    // CONVERSATIONS
    // =====================================================

    match /conversations/{conversationId} {

      // Only participants can read a conversation.
      allow get, list:
        if signedIn()
        && request.auth.uid in resource.data.participantIds;

      // Exactly two users in a private conversation.
      allow create:
        if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;

      // Participants can update conversation data,
      // but they cannot change who the participants are.
      allow update:
        if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds
           == resource.data.participantIds;

      // Either participant may remove the conversation.
      allow delete:
        if signedIn()
        && request.auth.uid in resource.data.participantIds;


      // ===================================================
      // MESSAGES
      // ===================================================

      match /messages/{messageId} {

        allow read:
          if isConversationMember(conversationId);

        // Only a participant can send a message.
        // The sender must actually be the authenticated user.
        allow create:
          if isConversationMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId is string
          && request.resource.data.receiverId in conversationParticipants(conversationId)
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        // Messages are immutable.
        allow update:
          if false;

        // Only the sender may delete their message.
        allow delete:
          if isConversationMember(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }


    // =====================================================
    // CALLS
    // =====================================================

    match /calls/{callId} {

      // Caller creates the call.
      allow create:
        if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.type in ["audio", "video"]
        && request.resource.data.status == "ringing";

      // Only caller or callee can see a call.
      allow get:
        if signedIn()
        && (
         