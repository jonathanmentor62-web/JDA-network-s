rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == "jonathanmentor62@gmail.com";
    }

    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status in ["approved", "active"];
    }

    function admin() {
      return isSuperAdmin() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // =========================
    // USERS
    // =========================
    match /users/{uid} {
      // FIXED: Allow pending OR active on create (was only pending - causing block)
      allow create:
        if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status in ["pending", "active", "approved"];

      // FIXED: Allow anyone signed in to read for registration check + admin
      allow read:
        if signedIn();

      // FIXED: Admin + SuperAdmin can update
      allow update:
        if admin() || isSuperAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
        );

      allow delete:
        if admin() || isSuperAdmin();
    }

    // =========================
    // USERNAMES - FIXED MAJOR BUG HERE!
    // =========================
    match /usernames/{username} {
      // FIXED: Allow public read to check if username exists BEFORE login
      allow read: if true;

      // FIXED: Allow creation right after auth (before user doc)
      allow create:
        if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete:
        if admin() || isSuperAdmin();
    }

    // =========================
    // ADMINS - FIXED BOOTSTRAP
    // =========================
    match /admins/{uid} {
      allow read:
        if signedIn();

      // FIXED: First admin (you) can create yourself!
      allow create:
        if isSuperAdmin() && request.auth.uid == uid;

      allow write:
        if admin() || isSuperAdmin();
    }

    // =========================
    // CONNECTIONS
    // =========================
    match /connections/{connectionId} {
      allow read, create, delete:
        if signedIn();
    }

    // =========================
    // CONVERSATIONS
    // =========================
    match /conversations/{conversationId} {
      allow read, create, update, delete:
        if signedIn();

      match /messages/{messageId} {
        allow read, create, update, delete:
          if signedIn();
      }
    }
  }
}