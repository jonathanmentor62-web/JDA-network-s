rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == "jonathanmentor62@gmail.com";
    }

    // =========================
    // PROFILE PHOTOS - FIXED
    // =========================

    // FIX 1: Allow upload to profilePhotos/UID (your app.js uses this)
    match /profilePhotos/{uid} {
      allow read: if true;
      allow write:
        if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // FIX 2: Also allow profilePhotos/UID/filename (for future)
    match /profilePhotos/{uid}/{fileName} {
      allow read: if true;
      allow write:
        if signedIn()
        && (request.auth.uid == uid || isSuperAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}