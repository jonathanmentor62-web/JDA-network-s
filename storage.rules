rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email
           == "jonathanmentor62@gmail.com";
    }

    function isAdmin() {
      return isSuperAdmin()
        || (
          signedIn()
          && firestore.exists(
            /databases/(default)/documents/admins/$(request.auth.uid)
          )
        );
    }


    // =====================================================
    // PROFILE PHOTOS
    // =====================================================

    // Current path used by index.html:
    // profilePhotos/{uid}/profile.{extension}

    match /profilePhotos/{uid}/{fileName} {

      // Signed-in members can view profile photos.
      allow read:
        if signedIn();


      // User can upload only their own profile photo.
      // Admins can also upload/manage photos.
      allow write:
        if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*'
        );


      allow delete:
        if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );
    }


    // =====================================================
    // LEGACY PROFILE PHOTO PATH
    // =====================================================

    // Keeps compatibility with older code that may use:
    // profilePhotos/{uid}.{extension}

    match /profilePhotos/{uid}.{extension} {

      allow read:
        if signedIn();

      allow write:
        if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*'
        );

      allow delete:
        if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );
    }

  } 
}